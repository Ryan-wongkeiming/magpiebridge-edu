{
  "name": "magpiebridge-edu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require ./scripts/fix-onedrive-readlink.js ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@prisma/client": "5.19.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-toast": "^1.2.23",
    "@react-pdf/renderer": "^3.4.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "14.2.13",
    "next-auth": "5.0.0-beta.18",
    "nodemailer": "^6.10.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "2.5.2",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "14.2.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "20.16.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.13",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^24.1.0",
    "postcss": "^8.5.28",
    "prisma": "5.19.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5",
    "vitest": "^1.6.0"
  }
